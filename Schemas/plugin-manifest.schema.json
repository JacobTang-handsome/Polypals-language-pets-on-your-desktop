{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polypals.app/schemas/plugin-manifest.schema.json",
  "title": "PolyPals Plugin Manifest v1",
  "type": "object",
  "required": ["formatVersion", "id", "kind", "name", "version", "minimumAppVersion", "author", "license", "languages", "levels", "capabilities", "assetDigests"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+){2,}$" },
    "kind": { "enum": ["content", "pet"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "$ref": "#/$defs/semver" },
    "minimumAppVersion": { "$ref": "#/$defs/semver" },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "levels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] } },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "assetDigests": { "type": "object", "propertyNames": { "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }, "additionalProperties": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } }
  },
  "additionalProperties": true,
  "$defs": { "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" } }
}
