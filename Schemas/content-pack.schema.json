{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polypals.app/schemas/content-pack.schema.json",
  "title": "PolyPals Content Cards v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 500,
  "items": {
    "type": "object",
    "required": ["petId", "type", "language", "minimumLevel", "recommendedLevel", "maximumLevel", "estimatedSeconds", "hook", "targetText", "prompt", "choices", "answer", "chineseHelp", "memoryKey"],
    "properties": {
      "petId": { "enum": ["sol", "mousse", "ash"] },
      "type": { "enum": ["expression", "dialogue", "culture", "listening", "scenario", "confusingWords", "picturePrompt"] },
      "language": { "type": "string", "minLength": 2 },
      "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
      "minimumLevel": { "enum": ["a1", "a2", "b1", "b2", "c1", "c2"] },
      "recommendedLevel": { "enum": ["a1", "a2", "b1", "b2", "c1", "c2"] },
      "maximumLevel": { "enum": ["a1", "a2", "b1", "b2", "c1", "c2"] },
      "estimatedSeconds": { "type": "integer", "minimum": 30, "maximum": 120 },
      "hook": { "type": "string" }, "targetText": { "type": "string", "minLength": 1 }, "prompt": { "type": "string", "minLength": 1 },
      "choices": { "type": "array", "maxItems": 3, "items": { "type": "string" } }, "answer": { "type": "string" }, "chineseHelp": { "type": "string" },
      "sourceTitle": { "type": ["string", "null"] }, "sourceURL": { "type": ["string", "null"], "format": "uri" }, "memoryKey": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": true
  }
}
